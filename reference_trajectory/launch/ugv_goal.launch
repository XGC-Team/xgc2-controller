<?xml version="1.0"?>
<launch>
    <!-- 目标位置参数 -->
    <arg name="goal_x" default="15.0" doc="目标点X坐标（米）"/>
    <arg name="goal_y" default="0.0" doc="目标点Y坐标（米）"/>
    <arg name="min_subscribers" default="1" doc="发布前等待的最少订阅者数量"/>
    <arg name="required_mpc_subscribers" default="0" doc="发布前必须连接的 UAV MPC goal 订阅者数量"/>
    <arg name="mpc_subscriber_regex" default="^/uav[0-9]+/mpc$" doc="用于识别 UAV MPC goal 订阅者节点名的正则表达式"/>
    <arg name="connection_timeout_sec" default="2.0" doc="等待订阅者连接的超时时间"/>
    <arg name="start_delay_sec" default="1.0" doc="goal 消息时间戳相对发布时间的延迟，用于同步启动 leader reference"/>
    <arg name="latch_hold_sec" default="2.0" doc="单次发布后保持 latched publisher 存活的时间"/>
    <arg name="publish_rate_hz" default="10.0" doc="等待订阅者连接时的检查频率"/>

    <!-- ========== Publish Goal Node ========== -->
    <node name="publish_goal" pkg="reference_trajectory" type="publish_goal.py" output="screen">
        <param name="goal_x" value="$(arg goal_x)"/>
        <param name="goal_y" value="$(arg goal_y)"/>
        <param name="min_subscribers" value="$(arg min_subscribers)"/>
        <param name="required_mpc_subscribers" value="$(arg required_mpc_subscribers)"/>
        <param name="mpc_subscriber_regex" value="$(arg mpc_subscriber_regex)"/>
        <param name="connection_timeout_sec" value="$(arg connection_timeout_sec)"/>
        <param name="start_delay_sec" value="$(arg start_delay_sec)"/>
        <param name="latch_hold_sec" value="$(arg latch_hold_sec)"/>
        <param name="publish_rate_hz" value="$(arg publish_rate_hz)"/>
    </node>
</launch>
